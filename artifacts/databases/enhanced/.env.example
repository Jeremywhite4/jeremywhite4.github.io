# Copy to ".env" and fill in real values. NEVER commit the real .env.
# The AnimalShelter data layer reads these at runtime so no credentials live in source.

# Least-privilege application user (read/write on the AAC database only).
AAC_USER=aacuser
AAC_PASS=change-me

# Connection target.
AAC_HOST=nv-desktop-services.apporto.com
AAC_PORT=30296
AAC_DB=AAC
AAC_COL=animals
AAC_AUTHSOURCE=AAC

# Optional: absolute path to the outcomes CSV used for seeding.
# AAC_CSV=./datasets/aac_shelter_outcomes.csv
