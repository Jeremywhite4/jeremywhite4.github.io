<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="@color/primary">

        <TextView
            android:id="@+id/textScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/title_weight_history"
            android:textSize="20sp"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

        <!-- Goal Weight Navigation -->
        <Button
            android:id="@+id/buttonGoalWeight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/button_goal"
            android:textSize="12sp"
            android:backgroundTint="@color/secondary" />
    </LinearLayout>

    <!-- Grid Column Headers -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@color/grid_header">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="@string/header_date"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="@string/header_weight"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/header_action"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center" />
    </LinearLayout>

    <!-- Scrollable Data Grid -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/layoutWeightGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Add Weight Button -->
    <Button
        android:id="@+id/buttonAddWeight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/button_add_weight"
        android:backgroundTint="@color/primary"
        android:textColor="@android:color/white"
        android:layout_margin="16dp" />

</LinearLayout>
