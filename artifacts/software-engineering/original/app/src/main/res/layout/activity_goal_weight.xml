<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@color/background">

    <!-- Screen Title -->
    <TextView
        android:id="@+id/textGoalTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_goal_weight"
        android:textSize="24sp"
        android:textColor="@color/primary"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <!-- Current Goal Display -->
    <TextView
        android:id="@+id/textCurrentGoal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/current_goal_not_set"
        android:textSize="16sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- Goal Weight Input -->
    <EditText
        android:id="@+id/editGoalWeight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_goal_weight"
        android:inputType="numberDecimal"
        android:padding="12dp"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="24dp"
        android:importantForAutofill="no" />

    <!-- Save Goal Button -->
    <Button
        android:id="@+id/buttonSaveGoal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/button_save_goal"
        android:backgroundTint="@color/primary"
        android:textColor="@android:color/white" />

</LinearLayout>
